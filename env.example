# ─────────────────────────────────────────────
# LLM providers — fallback chain: Groq → Gemini → local Qwen (Ollama)
# You need at least ONE of GROQ_API_KEY / GEMINI_API_KEY for scoring to work.
# ─────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=

# optional( qwen3:4b)
OLLAMA_MODEL=qwen3:4b

# ─────────────────────────────────────────────
# Embedding model 
# ─────────────────────────────────────────────
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# 
EMBEDDER_BATCH_SIZE=32
EMBEDDER_TOP_K=5

# data/chroma_db
CHROMA_PERSIST_DIRECTORY=data/chroma_db

# ─────────────────────────────────────────────
# GitHub 
# ─────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_USERNAME=

# ─────────────────────────────────────────────
# Scraper (Wuzzuf via Playwright)
# ─────────────────────────────────────────────
SCRAPE_DELAY_MIN=3
SCRAPE_DELAY_MAX=7
MAX_JOBS_PER_SOURCE=50
MAX_PAGES=3
HEADLESS=False

# ─────────────────────────────────────────────
# Notion export 
# ─────────────────────────────────────────────
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=
